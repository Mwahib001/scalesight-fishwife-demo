{
  "name": "scalesight-fishwife-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "pnpm test && node scripts/production.mjs build",
    "start": "node scripts/production.mjs start",
    "lint": "eslint",
    "test": "tsc -p tsconfig.tests.json && node .test-build/tests/fishwife.test.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests README.md playwright.config.ts",
    "verify:fishwife": "pnpm test && pnpm typecheck && pnpm lint && pnpm build && pnpm test:e2e",
    "test:production": "node tests/production-lifecycle.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
